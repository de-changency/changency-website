---
permalink: /kennis/index.html
---
{% extends "kennis-base.njk" %}

{% block title %}Kennis, artikelen over IT-adoptie en digitale vaardigheden, De Changency{% endblock %}

{% block meta %}
  <meta name="description" content="Artikelen over IT-adoptie, digitale vaardigheden en verandering die landt bij medewerkers. Kennis en inzichten vanuit De Changency.">
  <meta name="robots" content="index, follow">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.domain }}/kennis/">
  <meta property="og:title" content="Kennis, De Changency">
  <meta property="og:description" content="Artikelen over IT-adoptie, digitale vaardigheden en verandering die landt bij medewerkers.">
  <meta property="og:locale" content="nl_NL">
  <meta property="og:site_name" content="De Changency">
  <link rel="canonical" href="{{ site.domain }}/kennis/">
  <link rel="alternate" type="application/atom+xml" title="De Changency — Kennis" href="/kennis/feed.xml">
{% endblock %}

{% block content %}

    <!-- INTRO -->
    <section id="kennis-intro">
      <p class="label">Kennis</p>
      <h1>Kennis &amp; inzichten</h1>
      <p>
        Artikelen over IT-adoptie, digitale vaardigheden en verandering die landt
        bij de mensen die ermee werken.
      </p>
    </section>

    <!-- ARTIKELEN -->
    <section id="kennis-artikelen">
      {% if posts.length %}

      {% set featured = posts[0] %}
      <a href="{{ featured.url }}" class="kennis-featured">
        <div class="kennis-featured-text">
          <p class="kennis-tag">{% if featured.tags.length %}{{ featured.tags[0] | replace("-", " ") }}{% else %}Uitgelicht{% endif %}</p>
          <h2>{{ featured.title }}{% if featured.isDraft %} (concept){% endif %}</h2>
          <p>{{ featured.description }}</p>
          <span class="kennis-meta">{{ featured.readingTime }} min leestijd</span>
          <span class="kennis-lees">Lees het artikel →</span>
        </div>
        <div class="kennis-cover kennis-cover-v{{ featured.coverVariant }}">
          {% set coverImage = featured.image %}{% set coverVariant = featured.coverVariant %}{% include "kennis-cover.njk" %}
        </div>
      </a>

      {% if posts.length > 1 %}
      <div class="kennis-grid">
        {% for post in posts %}
        {% if not loop.first %}
        <a href="{{ post.url }}" class="kennis-card">
          <div class="kennis-cover kennis-cover-v{{ post.coverVariant }}">
            {% set coverImage = post.image %}{% set coverVariant = post.coverVariant %}{% include "kennis-cover.njk" %}
          </div>
          <div class="kennis-card-body">
            <p class="kennis-tag">{% if post.tags.length %}{{ post.tags[0] | replace("-", " ") }}{% else %}Kennis{% endif %}</p>
            <h3>{{ post.title }}{% if post.isDraft %} (concept){% endif %}</h3>
            <p>{{ post.description }}</p>
            <span class="kennis-meta">{{ post.readingTime }} min leestijd</span>
          </div>
        </a>
        {% endif %}
        {% endfor %}
      </div>
      {% endif %}

      {% else %}
      <p>Er staan nog geen artikelen online. Kom binnenkort terug!</p>
      {% endif %}
    </section>

    <!-- CTA -->
    <section id="cta">
      <h2>Verder praten over wat dit voor jouw organisatie betekent?</h2>
      <p>{{ site.ctaDefault.intro }}</p>
      <a href="{{ site.ctaDefault.url }}" target="_blank" rel="noopener">
        {{ site.ctaDefault.text }}
      </a>
    </section>

{% endblock %}

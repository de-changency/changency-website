---
pagination:
  data: posts
  size: 1
  alias: post
permalink: "/kennis/{{ post.slug }}/index.html"
eleventyExcludeFromCollections: true
---
{% extends "kennis-base.njk" %}

{% block title %}{{ post.title }}, De Changency{% endblock %}

{% block meta %}
  <meta name="description" content="{{ post.description }}">
  <meta name="robots" content="index, follow">
  <meta property="og:type" content="article">
  <meta property="og:url" content="{{ post.absoluteUrl }}">
  <meta property="og:title" content="{{ post.title }}, De Changency">
  <meta property="og:description" content="{{ post.description }}">
  {% if post.imageUrl or site.ogDefault %}
  <meta property="og:image" content="{{ post.imageUrl or site.ogDefault }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ post.imageUrl or site.ogDefault }}">
  {% endif %}
  <meta property="og:locale" content="nl_NL">
  <meta property="og:site_name" content="De Changency">
  <meta property="article:published_time" content="{{ post.dateISO }}">
  <link rel="canonical" href="{{ post.canonicalUrl }}">
  <link rel="alternate" type="application/atom+xml" title="De Changency — Kennis" href="/kennis/feed.xml">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ post.title | dump | safe }},
    "description": {{ post.description | dump | safe }},
    "datePublished": "{{ post.dateISO }}",
    "inLanguage": "nl",
    {% if post.imageUrl %}"image": "{{ post.imageUrl }}",{% endif %}
    "url": "{{ post.absoluteUrl }}",
    "mainEntityOfPage": "{{ post.canonicalUrl }}",
    "author": {
      "@type": "Person",
      "name": "Ilse Polak"
    },
    "publisher": {
      "@type": "Organization",
      "name": "{{ site.name }}",
      "url": "{{ site.domain }}"
    }
  }
  </script>
{% endblock %}

{% block content %}

    <!-- ARTIKEL -->
    <section class="legal-page kennis-article">
      <div class="legal-document">
        <a href="/kennis/" class="kennis-backlink">← Alle artikelen</a>
        <p class="label">{% if post.tags.length %}{{ post.tags[0] | replace("-", " ") }}{% else %}Kennis{% endif %}</p>
        <h1>{{ post.title }}</h1>
        <p class="kennis-article-meta">{{ post.readingTime }} min leestijd · door Ilse Polak</p>
        <div class="kennis-cover kennis-cover-v{{ post.coverVariant }} kennis-article-banner">
          {% set coverImage = post.image %}{% set coverVariant = post.coverVariant %}{% include "kennis-cover.njk" %}
        </div>
        {{ post.html | safe }}

        <div class="kennis-reageer">
          <h3>Doorpraten over dit onderwerp?</h3>
          <p>Reageren kan via LinkedIn — daar deel ik ook nieuwe artikelen en inzichten. Of stuur direct een bericht.</p>
          <div class="kennis-reageer-links">
            <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ post.absoluteUrl | urlencode }}" target="_blank" rel="noopener">Deel op LinkedIn</a>
            <a href="https://www.linkedin.com/in/ilse-polak/" target="_blank" rel="noopener">Volg Ilse op LinkedIn</a>
            <a href="mailto:ilse@de-changency.nl?subject=Reactie op: {{ post.title }}">Reageer via e-mail</a>
          </div>
        </div>

        <div class="kennis-auteur">
          <img src="/images/ilse-avatar.png" alt="Ilse Polak">
          <div>
            <strong>Ilse Polak</strong>
            <p>Oprichter van De Changency en SAAR Insights. Helpt woningcorporaties en maatschappelijke organisaties bij IT-adoptie en het versterken van digitale vaardigheden.</p>
          </div>
        </div>

        {% if post.alsoOn %}
        <p class="kennis-crosslink">
          {% if post.isPrimary %}
          Dit artikel is ook te lezen op <a href="{{ post.alsoOn.url }}" target="_blank" rel="noopener">{{ post.alsoOn.name }}</a>.
          {% else %}
          Dit artikel verscheen oorspronkelijk op <a href="{{ post.alsoOn.url }}" target="_blank" rel="noopener">{{ post.alsoOn.name }}</a>.
          {% endif %}
        </p>
        {% endif %}
      </div>
    </section>

    <!-- CTA -->
    <section id="cta">
      <h2>Verder praten over wat dit voor jouw organisatie betekent?</h2>
      {% set cta = post.cta or site.ctaDefault %}
      <p>{{ site.ctaDefault.intro }}</p>
      <a href="{{ cta.url }}" target="_blank" rel="noopener">
        {{ cta.text }}
      </a>
    </section>

{% endblock %}

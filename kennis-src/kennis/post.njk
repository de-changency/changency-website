---
pagination:
  data: posts
  size: 1
  alias: post
permalink: "/kennis/{{ post.slug }}/index.html"
eleventyExcludeFromCollections: true
---
{% extends "kennis-base.njk" %}

{% block title %}{{ post.title }}, De Changency{% endblock %}

{% block meta %}
  <meta name="description" content="{{ post.description }}">
  <meta name="robots" content="index, follow">
  <meta property="og:type" content="article">
  <meta property="og:url" content="{{ post.absoluteUrl }}">
  <meta property="og:title" content="{{ post.title }}, De Changency">
  <meta property="og:description" content="{{ post.description }}">
  {% if post.imageUrl or site.ogDefault %}
  <meta property="og:image" content="{{ post.imageUrl or site.ogDefault }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ post.imageUrl or site.ogDefault }}">
  {% endif %}
  <meta property="og:locale" content="nl_NL">
  <meta property="og:site_name" content="De Changency">
  <meta property="article:published_time" content="{{ post.dateISO }}">
  <link rel="canonical" href="{{ post.canonicalUrl }}">
  <link rel="alternate" type="application/atom+xml" title="Kennis | De Changency" href="/kennis/feed.xml">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ post.title | dump | safe }},
    "description": {{ post.description | dump | safe }},
    "datePublished": "{{ post.dateISO }}",
    "inLanguage": "nl",
    {% if post.label %}"articleSection": {{ post.label | dump | safe }},{% endif %}
    {% if post.imageUrl %}"image": "{{ post.imageUrl }}",{% endif %}
    "url": "{{ post.absoluteUrl }}",
    "mainEntityOfPage": "{{ post.canonicalUrl }}",
    "author": {
      "@type": "Person",
      "name": "Ilse Polak"
    },
    "publisher": {
      "@type": "Organization",
      "name": "{{ site.name }}",
      "url": "{{ site.domain }}"
    }
  }
  </script>
{% endblock %}

{% block content %}

    <!-- ARTIKEL -->
    <section class="legal-page kennis-article">
      <div class="legal-document">
        <a href="/kennis/" class="kennis-backlink">← Alle artikelen</a>
        <p class="label">{{ post.label or "Kennis" }}</p>
        <h1>{{ post.title }}</h1>
        <p class="kennis-article-meta">{{ post.readingTime }} min leestijd · door Ilse Polak</p>
        {% if post.image %}
        <div class="kennis-cover kennis-article-banner">
          <img src="/kennis/{{ post.image }}" alt="">
        </div>
        {% endif %}
        {{ post.html | safe }}

        {% if post.bronnen.length %}
        <div class="kennis-bronnen">
          <h3>Bronnen</h3>
          <ul>
            {% for bron in post.bronnen %}
            <li>{{ bron }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}

        <div class="kennis-reageer">
          <h3>Delen of doorpraten?</h3>
          <p>Stuur dit artikel door naar een collega of praat verder op <a href="https://www.linkedin.com/in/ilse-polak/" target="_blank" rel="noopener">LinkedIn</a>.</p>
          <div class="kennis-share-icons">
            <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ post.absoluteUrl | urlencode }}" target="_blank" rel="noopener" aria-label="Deel op LinkedIn" title="Deel op LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
            </a>
            <a href="https://wa.me/?text={{ (post.title + " - " + post.absoluteUrl) | urlencode }}" target="_blank" rel="noopener" aria-label="Deel via WhatsApp" title="Deel via WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            </a>
            <a href="mailto:?subject={{ post.title | urlencode }}&body={{ ("Dit artikel is misschien interessant voor je: " + post.absoluteUrl) | urlencode }}" aria-label="Mail naar een collega" title="Mail naar een collega">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </a>
            <a href="#" data-copy="{{ post.absoluteUrl }}" aria-label="Kopieer link" title="Kopieer link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </a>
          </div>
        </div>

        <div class="kennis-auteur">
          <div class="kennis-auteur-circle">
            <img src="/images/story-person.png" alt="Ilse Polak">
          </div>
          <div>
            <strong>Ilse Polak</strong>
            <p>Oprichter van De Changency en SAAR Insights. Helpt woningcorporaties bij het meten en versterken van digitale vaardigheden en bouwt met training en e-learning aan lerende organisaties.</p>
          </div>
        </div>

        {% if post.alsoOn %}
        <p class="kennis-crosslink">
          Dit artikel is ook te lezen op <a href="{{ post.alsoOn.url }}" target="_blank" rel="noopener">{{ post.alsoOn.name }}</a>.
        </p>
        {% endif %}

        <p class="kennis-alle-artikelen"><a href="/kennis/" class="kennis-backlink">← Alle artikelen</a></p>
      </div>
    </section>

    <!-- CTA -->
    <section id="cta">
      <h2>Verder praten of interesse in een traject?</h2>
      {% set cta = post.cta or site.ctaDefault %}
      <p>{{ site.ctaDefault.intro }}</p>
      <a href="{{ cta.url }}" target="_blank" rel="noopener">
        {{ cta.text }}
      </a>
    </section>

    <script>
    document.querySelectorAll('[data-copy]').forEach(function (el) {
        el.addEventListener('click', function (e) {
            e.preventDefault();
            navigator.clipboard.writeText(el.getAttribute('data-copy')).then(function () {
                el.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
                el.setAttribute('title', 'Link gekopieerd');
                el.setAttribute('aria-label', 'Link gekopieerd');
            });
        });
    });
    </script>

{% endblock %}

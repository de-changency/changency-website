{# Branded cover: eigen afbeelding indien aanwezig, anders Changency-cirkelmotief (variant 1-4) #}
{% if coverImage %}
<img src="/kennis/{{ coverImage }}" alt="">
{% else %}
<svg viewBox="0 0 400 200" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  {% if coverVariant == 1 %}
  <circle cx="175" cy="105" r="46" fill="#D4A0B0"/>
  <circle cx="235" cy="85" r="46" fill="#8B3A62" fill-opacity="0.88"/>
  {% elif coverVariant == 2 %}
  <circle cx="120" cy="130" r="34" fill="#A85080"/>
  <circle cx="200" cy="95" r="40" fill="#8B3A62"/>
  <circle cx="285" cy="62" r="34" fill="#3D1F2E"/>
  {% elif coverVariant == 3 %}
  <circle cx="180" cy="95" r="52" fill="none" stroke="#A85080" stroke-width="3"/>
  <circle cx="248" cy="120" r="34" fill="#8B3A62"/>
  {% else %}
  <circle cx="175" cy="105" r="44" fill="rgba(255,255,255,0.35)"/>
  <circle cx="238" cy="82" r="44" fill="#FFFFFF" fill-opacity="0.92"/>
  {% endif %}
</svg>
{% endif %}

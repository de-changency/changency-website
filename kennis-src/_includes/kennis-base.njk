<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Kennis, De Changency{% endblock %}</title>
  {% block meta %}{% endblock %}
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/variables.css?v={{ site.cssVersions.variables }}">
  <link rel="stylesheet" href="/css/base.css?v={{ site.cssVersions.base }}">
  <link rel="stylesheet" href="/css/components.css?v={{ site.cssVersions.components }}">
  <link rel="stylesheet" href="/css/pages.css?v={{ site.cssVersions.pages }}">
</head>
<body>

  <!-- NAVIGATIE -->
  <header>
    <nav>
      <a href="/">
        <img src="/images/logo.png" alt="De Changency">
      </a>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/diensten">Diensten</a></li>
        <li><a href="/over">Over</a></li>
        <li><a href="/recensies">Recensies</a></li>
        <li><a href="/kennis/" class="active">Kennis</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
      <a href="{{ site.bookingUrl }}" class="nav-cta" target="_blank" rel="noopener">
        Plan een kennismaking
      </a>
      <button type="button" class="hamburger" aria-label="Menu openen" aria-expanded="false" aria-controls="site-nav-mobile">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </nav>
  </header>

  <!-- MOBILE NAV -->
  <div class="mobile-nav" id="site-nav-mobile">
    <button type="button" class="mobile-nav-close" aria-label="Menu sluiten">
      <span class="mobile-nav-close-line" aria-hidden="true"></span>
      <span class="mobile-nav-close-line" aria-hidden="true"></span>
    </button>
    <div class="mobile-nav-links">
      <a href="/">Home</a>
      <a href="/diensten">Diensten</a>
      <a href="/over">Over</a>
      <a href="/recensies">Recensies</a>
      <a href="/kennis/" class="active">Kennis</a>
      <a href="/contact">Contact</a>
      <a href="{{ site.bookingUrl }}" class="mobile-cta" target="_blank" rel="noopener">
        Plan een kennismaking
      </a>
    </div>
  </div>

  <main>
{% block content %}{% endblock %}
  </main>

  <!-- FOOTER -->
  <footer>
    <div class="footer-columns">
      <div class="footer-brand">
        <img src="/images/logo.png" alt="De Changency">
        <p>
          Advies en begeleiding bij IT-adoptie en het versterken van digitale
          vaardigheden. Voor woningcorporaties en maatschappelijke organisaties.
        </p>
      </div>
      <div>
        <h4>Pagina's</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/diensten">Diensten</a></li>
          <li><a href="/diensten/adoptie">Adoptie &amp; implementatie</a></li>
          <li><a href="/diensten/digitale-vaardigheden">Digitale vaardigheden</a></li>
          <li><a href="/over">Over</a></li>
          <li><a href="/recensies">Recensies</a></li>
          <li><a href="/kennis/">Kennis</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Meer</h4>
        <ul>
          <li><a href="https://www.saar-insights.nl/" target="_blank" rel="noopener">SAAR Insights</a></li>
          <li><a href="https://www.linkedin.com/in/ilse-polak/" target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 De Changency</p>
      <nav class="footer-legal" aria-label="Juridisch">
        <a href="/privacy">Privacy</a>
      </nav>
    </div>
  </footer>

  <script src="/js/main.js?v={{ site.jsVersion }}"></script>
{% if site.goatcounter %}
    <script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
{% endif %}
</body>
</html>
